# Copy to .env and fill in. Keep secrets in .env.local (git-ignored, loaded before .env).

# ───────────────────────── Vercel AI Gateway (default: one key for chat + images) ─────────────────────────
# Get a key at https://vercel.com/ai-gateway (or run `npx vercel ai-gateway setup`, which writes .env.local).
# Never put the real key here — put it in .env.local:
#   AI_GATEWAY_API_KEY=...

# ───────────────────────── Chat / card-building models (used by pi; format provider/model[:thinking]) ─────────────────────────
# These are defaults. Switch at runtime, effective immediately, with
#   `npm run model -- chat vercel-ai-gateway/openai/gpt-5-mini`   (or POST /api/models); `npm run model -- reset` restores them.
# Chosen for cost-effectiveness. Gateway prices ($ per 1M tokens, input / output, 2026-09):
#   vercel-ai-gateway/google/gemini-3-flash        0.50 / 3.00   default for building cards (tool use + long context)
#   vercel-ai-gateway/google/gemini-3.1-flash-lite 0.25 / 1.50   default for buyer chat
#   vercel-ai-gateway/openai/gpt-5-mini            0.25 / 2.00   alternative
#   vercel-ai-gateway/deepseek/deepseek-v4-flash   0.13 / 0.26   cheapest; weaker at multi-step tool use
#   vercel-ai-gateway/anthropic/claude-haiku-4.5   1.00 / 5.00   more reliable tool use
#   vercel-ai-gateway/anthropic/claude-sonnet-4.5  3.00 / 15.00  quality first
PI_MODEL=vercel-ai-gateway/google/gemini-3-flash
PI_CHAT_MODEL=vercel-ai-gateway/google/gemini-3.1-flash-lite
# off | minimal | low | medium | high
PI_THINKING=low

# Without the gateway, pi also accepts direct provider keys, e.g.
#   ANTHROPIC_API_KEY=...   PI_MODEL=anthropic/claude-sonnet-4-5
#   OPENAI_API_KEY=...      PI_MODEL=openai/gpt-5-mini
# Anthropic-compatible relay: ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN, then PI_MODEL=anthropic-proxy/<model id>

# ───────────────────────── Image generation (the card's layers) ─────────────────────────
# gateway : Vercel AI Gateway (default)
# openai  : OpenAI Images API directly (OPENAI_IMAGE_API_KEY)
# gemini  : Google Gemini image models directly (GEMINI_API_KEY; no alpha, chroma_key fallback)
# mock    : Pillow placeholders, testing only
IMAGE_PROVIDER=gateway
# Gateway image model (approx. price per image, 2026-09):
#   openai/gpt-image-1-mini            ≈ $0.01–0.02  default: cheap, native transparent background (needed for the subject layer)
#   google/gemini-3.1-flash-lite-image ≈ $0.034      no alpha; the agent cuts out the subject with chroma_key
#   google/gemini-2.5-flash-image      ≈ $0.039
#   openai/gpt-image-1                 ≈ $0.04–0.17  quality first
GATEWAY_IMAGE_MODEL=openai/gpt-image-1-mini
# Tag sent with every Gateway request (ai-reporting-tags) so the spend report can be filtered to this agent.
# Change it if several agents share one Vercel account.
# GATEWAY_REPORTING_TAG=holo-card-agent
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ───────────────────────── Termix marketplace ─────────────────────────
# bsc | base | rh — each chain is a completely separate marketplace
AACP_CHAIN=bsc
# Identity is fixed to key mode (unattended): the service signs accept / deliver / claim locally with a
# dedicated hot wallet. Put the private key in .env.local (git-ignored) and fund the wallet with a little gas (BNB on BSC):
#   WALLET_KEY=0x...
# The agent to host (DB cuid). List this wallet's agents with `npm run setup -- agents`;
# mint one with `npm run setup -- mint <name> "<display name>"` if there is none.
A2A_AGENT_ID=

# ───────────────────────── Service / delivery ─────────────────────────
# Data directory (orders, generated cards, conversations)
DATA_DIR=./data
# Built-in HTTP server: health check + live gallery at /cards/<jobId>/
HTTP_PORT=8787
HTTP_HOST=0.0.0.0
# Public URL of that server (used for the online preview link in deliveries), e.g. https://cards.example.com
PUBLIC_BASE_URL=
# Optional token required by remote callers of POST /api/models (loopback callers need none)
ADMIN_TOKEN=
# Timeout per card build (minutes)
JOB_TIMEOUT_MINUTES=40
# Orders built concurrently
JOB_CONCURRENCY=1
# Order sweep interval (seconds): accept missed orders / redo / claim after the challenge window
SWEEP_INTERVAL_SECONDS=300
# Optional webhook: delivery, failure and claim events are POSTed here
NOTIFY_WEBHOOK_URL=

# ───────────────────────── Listing (what is sold, and how) ─────────────────────────
SERVICE_TITLE=Custom AI 3D Holographic Collectible Card (Holo Card Studio)
SERVICE_PRICE=15
SERVICE_CURRENCY=USDC
SERVICE_DELIVERY_DAYS=2
SERVICE_CATEGORY=Design & Brand
SERVICE_SKILL_TAG=holo-card-design
