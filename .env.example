# ───────────────────────── 网络 / 代理 ─────────────────────────
# auto  : 启动时探测直连，失败则走本地代理（推荐）
# always: 所有出站请求都走代理
# off   : 不用代理
PROXY_MODE=auto
PROXY_URL=http://127.0.0.1:1080
# auto 模式用来探测直连是否可用的地址
PROXY_PROBE_URL=https://api.openai.com/v1/models
NO_PROXY=localhost,127.0.0.1,::1

# ───────────────────────── LLM（pi agent 使用）─────────────────────────
# pi 支持的任意 provider。常用：
#   ANTHROPIC_API_KEY=sk-ant-...        PI_MODEL=anthropic/claude-sonnet-4-5
#   OPENAI_API_KEY=sk-...               PI_MODEL=openai/gpt-5
#   OPENROUTER_API_KEY=sk-or-...        PI_MODEL=openrouter/anthropic/claude-sonnet-4-5
#   GEMINI_API_KEY=...                  PI_MODEL=google/gemini-2.5-pro
# 如果你用的是 Anthropic 兼容中转站，填 ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN（或 ANTHROPIC_API_KEY），
# 程序会自动注册一个 anthropic-proxy provider，PI_MODEL 写 anthropic-proxy/<模型id>。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
PI_MODEL=anthropic/claude-sonnet-4-5
# off | minimal | low | medium | high
PI_THINKING=medium
# 聊天回复用的（更便宜的）模型，留空则与 PI_MODEL 相同
PI_CHAT_MODEL=

# ───────────────────────── 图像生成（闪卡四层图）─────────────────────────
# openai : OpenAI Images API（gpt-image-1，原生支持透明背景，推荐）
# gemini : Google Gemini 图像模型（不支持透明，程序会用抠图兜底）
IMAGE_PROVIDER=openai
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ───────────────────────── Termix 市场 ─────────────────────────
# bsc | base | rh  —— 每条链是完全独立的市场
AACP_CHAIN=bsc
# 要托管上线的 agent（DB cuid），`npm run setup -- agents` 可列出
A2A_AGENT_ID=
# 身份三选一（优先级 linked > agentic > key）：
#  1) linked : 运行 `npm run setup -- link`，手机/浏览器扫码授权即可；上链步骤需人在浏览器签名。
#     服务器无人值守时可把网页授权得到的 key 放到 TERMIX_API_KEY（仍需人签名上链）。
#  2) key    : 完全无人值守。专用热钱包私钥，只放少量 gas。
TERMIX_API_KEY=
TERMIX_WALLET_MODE=
WALLET_KEY=

# ───────────────────────── 服务 / 交付 ─────────────────────────
# 数据目录（订单、生成的卡、会话）
DATA_DIR=./data
# 内置 HTTP 服务端口：健康检查 + 在线预览画廊 /cards/<jobId>/
HTTP_PORT=8787
HTTP_HOST=0.0.0.0
# 对外可访问的地址（用于交付说明里的在线预览链接），如 https://cards.example.com
PUBLIC_BASE_URL=
# 每张卡的生成超时（分钟）
JOB_TIMEOUT_MINUTES=40
# 并发生成的订单数
JOB_CONCURRENCY=1
# 订单巡检间隔（秒）：接单 / 补漏 / 挑战期后领款
SWEEP_INTERVAL_SECONDS=300
# 可选：事件通知 webhook（签名请求、交付、失败会 POST 到这里）
NOTIFY_WEBHOOK_URL=

# ───────────────────────── 服务信息（卖什么、怎么卖）─────────────────────────
SERVICE_TITLE=AI 3D 全息闪卡定制（Holo Card Studio）
SERVICE_PRICE=15
SERVICE_CURRENCY=USDC
SERVICE_DELIVERY_DAYS=2
SERVICE_CATEGORY=Design & Brand
SERVICE_SKILL_TAG=holo-card-design
