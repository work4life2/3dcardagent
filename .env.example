# 复制为 .env 后填写。密钥建议放在 .env.local（已被 git 忽略，优先级高于 .env）。

# ───────────────────────── Vercel AI Gateway（默认，一把 key 通吃对话 + 生图）─────────────────────────
# 获取：npx vercel ai-gateway setup（会写入 .env.local），或在 https://vercel.com/ai-gateway 创建。
# 不要把真实 key 写在这里，放 .env.local：
#   AI_GATEWAY_API_KEY=...

# ───────────────────────── 对话 / 做卡模型（pi 使用，格式 provider/model[:thinking]）─────────────────────────
# 这里是默认值；运行中可随时切换且立即生效：`npm run model -- chat vercel-ai-gateway/openai/gpt-5-mini`
# （或 POST /api/models），`npm run model -- reset` 恢复默认。
# 默认按性价比选。网关价格（$/百万 token，输入/输出，2026-09）：
#   vercel-ai-gateway/google/gemini-3-flash        0.50 / 3.00   做卡（工具调用 + 长上下文）默认
#   vercel-ai-gateway/google/gemini-3.1-flash-lite 0.25 / 1.50   聊天回复默认
#   vercel-ai-gateway/openai/gpt-5-mini            0.25 / 2.00   备选
#   vercel-ai-gateway/deepseek/deepseek-v4-flash   0.13 / 0.26   最便宜，做卡能力略弱
#   vercel-ai-gateway/anthropic/claude-haiku-4.5   1.00 / 5.00   更稳的工具调用
#   vercel-ai-gateway/anthropic/claude-sonnet-4.5  3.00 / 15.00  质量优先
PI_MODEL=vercel-ai-gateway/google/gemini-3-flash
PI_CHAT_MODEL=vercel-ai-gateway/google/gemini-3.1-flash-lite
# off | minimal | low | medium | high
PI_THINKING=low

# 不走网关时，pi 也支持直接填 provider key，例如：
#   ANTHROPIC_API_KEY=...   PI_MODEL=anthropic/claude-sonnet-4-5
#   OPENAI_API_KEY=...      PI_MODEL=openai/gpt-5-mini
# Anthropic 兼容中转：ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN，PI_MODEL=anthropic-proxy/<模型id>

# ───────────────────────── 图像生成（闪卡四层图）─────────────────────────
# gateway : 走 Vercel AI Gateway（默认）
# openai  : 直连 OpenAI Images API（OPENAI_IMAGE_API_KEY）
# gemini  : 直连 Google Gemini 图像模型（GEMINI_API_KEY，不支持透明，程序用抠图兜底）
# mock    : Pillow 占位图，仅联调
IMAGE_PROVIDER=gateway
# 网关图像模型（每张约价，2026-09）：
#   openai/gpt-image-1-mini            ≈ $0.01–0.02  默认：便宜且原生支持透明背景（主体层需要）
#   google/gemini-3.1-flash-lite-image ≈ $0.034      无透明，程序用 chroma_key 抠图
#   google/gemini-2.5-flash-image      ≈ $0.039
#   openai/gpt-image-1                 ≈ $0.04–0.17  质量优先
GATEWAY_IMAGE_MODEL=openai/gpt-image-1-mini
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ───────────────────────── Termix 市场 ─────────────────────────
# bsc | base | rh  —— 每条链是完全独立的市场
AACP_CHAIN=bsc
# 身份固定为密钥模式（无人值守）：程序用专用热钱包私钥本地签名接单 / 交付 / 领款。
# 私钥放 .env.local（git 已忽略），钱包只充少量 gas（BSC 用 BNB）：
#   WALLET_KEY=0x...
# 要托管上线的 agent（DB cuid）。该钱包下的 agent 用 `npm run setup -- agents` 列出，
# 没有就 `npm run setup -- mint <name> "<显示名>"` 铸造一个。
A2A_AGENT_ID=

# ───────────────────────── 服务 / 交付 ─────────────────────────
# 数据目录（订单、生成的卡、会话）
DATA_DIR=./data
# 内置 HTTP 服务端口：健康检查 + 在线预览画廊 /cards/<jobId>/
HTTP_PORT=8787
HTTP_HOST=0.0.0.0
# 对外可访问的地址（用于交付说明里的在线预览链接），如 https://cards.example.com
PUBLIC_BASE_URL=
# 每张卡的生成超时（分钟）
JOB_TIMEOUT_MINUTES=40
# 并发生成的订单数
JOB_CONCURRENCY=1
# 订单巡检间隔（秒）：接单 / 补漏 / 挑战期后领款
SWEEP_INTERVAL_SECONDS=300
# 可选：事件通知 webhook（签名请求、交付、失败会 POST 到这里）
NOTIFY_WEBHOOK_URL=

# ───────────────────────── 服务信息（卖什么、怎么卖）─────────────────────────
SERVICE_TITLE=AI 3D 全息闪卡定制（Holo Card Studio）
SERVICE_PRICE=15
SERVICE_CURRENCY=USDC
SERVICE_DELIVERY_DAYS=2
SERVICE_CATEGORY=Design & Brand
SERVICE_SKILL_TAG=holo-card-design
