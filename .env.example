# Copy to .env and fill in. Keep secrets in .env.local (git-ignored, loaded before .env).

# ───────────────────────── Model relay (default: one key for chat + images) ─────────────────────────
# OpenAI-compatible relay (New API style). Default https://www.cun.ai; any relay that serves
# /v1/chat/completions, /v1/messages (Anthropic) and /v1/images/generations works.
RELAY_BASE_URL=https://www.cun.ai
# Never put the real key here — put it in .env.local:
#   RELAY_API_KEY=sk-...

# ───────────────────────── Chat / card-building models (used by pi; format provider/model[:thinking]) ─────────────────────────
# `relay/<id>` = any text model on the relay's catalog (`npm run model -- list`). Claude models go through the
# relay's Anthropic endpoint, everything else through OpenAI chat completions. Prices: see the relay's pricing page.
# Switch at runtime, effective immediately, with
#   `npm run model -- chat relay/gpt-5.4-mini`   (or POST /api/models); `npm run model -- reset` restores them.
#   relay/gemini-3-flash          default for building cards (tool use + long context)
#   relay/gemini-2.5-flash-lite   default for buyer chat
#   relay/gpt-5.4-mini            alternative
#   relay/deepseek-v4-flash       cheapest; weaker at multi-step tool use
#   relay/claude-haiku-4-5        more reliable tool use
#   relay/claude-sonnet-5         quality first
PI_MODEL=relay/gemini-3-flash
PI_CHAT_MODEL=relay/gemini-2.5-flash-lite
# off | minimal | low | medium | high
PI_THINKING=low

# Without the relay, pi also accepts direct provider keys, e.g.
#   ANTHROPIC_API_KEY=...   PI_MODEL=anthropic/claude-sonnet-4-5
#   OPENAI_API_KEY=...      PI_MODEL=openai/gpt-5-mini
# Anthropic-compatible relay: ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN, then PI_MODEL=anthropic-proxy/<model id>

# ───────────────────────── Image generation (the card's layers) ─────────────────────────
# relay   : the relay's OpenAI Images API (default)
# openai  : OpenAI Images API directly (OPENAI_IMAGE_API_KEY)
# gemini  : Google Gemini image models directly (GEMINI_API_KEY; no alpha, chroma_key fallback)
# mock    : Pillow placeholders, testing only
IMAGE_PROVIDER=relay
# Relay image model.
#   gpt-image-2               Images API, native transparent background (best subject cut-outs); ≈ $0.08 per image observed
#   gpt-image-2.5-flare / -sunburst   newer / pricier
#   gemini-3.1-flash-image    chat-completions image, cheaper; no alpha, the agent cuts the subject out with chroma_key
#   gemini-2.5-flash-image    same, older
RELAY_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ───────────────────────── Termix marketplace ─────────────────────────
# bsc | base | rh — each chain is a completely separate marketplace
AACP_CHAIN=bsc
# Identity is fixed to key mode (unattended): the service signs accept / deliver / claim locally with a
# dedicated hot wallet. Put the private key in .env.local (git-ignored) and fund the wallet with a little gas (BNB on BSC):
#   WALLET_KEY=0x...
# JSON-RPC node used to broadcast and confirm transactions. Leave empty for the built-in default
# (BSC: https://bsc-dataseed.bnbchain.org — the skill's own default, bsc-rpc.publicnode.com, refuses
# eth_getTransactionReceipt without an API key, which made every accept/deliver look like a receipt timeout).
A2A_RPC_URL=
# The agent to host (DB cuid). List this wallet's agents with `npm run setup -- agents`;
# mint one with `npm run setup -- mint <name> "<display name>"` if there is none.
A2A_AGENT_ID=

# ───────────────────────── Service / delivery ─────────────────────────
# Data directory (orders, generated cards, conversations)
DATA_DIR=./data
# Built-in HTTP server: health check + live gallery at /cards/<jobId>/
HTTP_PORT=8787
HTTP_HOST=0.0.0.0
# Public URL of that server (used for the online preview link in deliveries), e.g. https://cards.example.com
PUBLIC_BASE_URL=
# Optional token required by remote callers of POST /api/models (loopback callers need none)
ADMIN_TOKEN=
# Timeout per card build (minutes)
JOB_TIMEOUT_MINUTES=40
# Orders built concurrently
JOB_CONCURRENCY=1
# Order sweep interval (seconds): accept missed orders / redo / claim after the challenge window
SWEEP_INTERVAL_SECONDS=300
# Optional webhook: delivery, failure and claim events are POSTed here
NOTIFY_WEBHOOK_URL=

# ───────────────────────── Listing (what is sold, and how) ─────────────────────────
SERVICE_TITLE=Custom AI 3D Holographic Collectible Card (Holo Card Studio)
SERVICE_PRICE=1
SERVICE_CURRENCY=USDC
SERVICE_DELIVERY_DAYS=1
SERVICE_CATEGORY=Design & Brand
SERVICE_SKILL_TAG=holo-card-design
